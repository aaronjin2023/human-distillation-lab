{
  "id": "fernand-braudel",
  "name": "Fernand Braudel",
  "name_zh": "费尔南·布罗代尔",
  "kind": "expert-method",
  "domain": "history",
  "version": "0.1.0",
  "updated_at": "2026-10-28",
  "status": "source-grounded-draft",
  "scope": "聚焦布罗代尔的时间尺度和空间组织方法；不把长时段当作唯一合法史学，也不把后世总结冒充原文。",
  "source_works": [
    "《历史与社会科学：长时段》",
    "《菲利普二世时代的地中海和地中海世界》"
  ],
  "sources": [
    {
      "id": "S1",
      "title": "Histoire et Sciences sociales : La longue durée (1958)",
      "url": "https://www.persee.fr/doc/ahess_0395-2649_1958_num_13_4_2781",
      "publisher": "Fernand Braudel / Annales；Persée数字人文平台",
      "source_type": "primary-text",
      "access_note": "Persée页面已打开并读到文章实际OCR文本；页面明确指出历史时间不只短时事件，也讨论价格、人口、工资等需要更长观察尺度的变动。OCR未经校订，按概念摘要使用，不引用其识别错字。",
      "supports": [
        "长时段分析与经济、社会、制度等缓慢变动的连接",
        "布罗代尔明确写道经济社会史转向并非彻底抛弃短时段",
        "单日或单年不适合所有问题，观察尺度应匹配对象"
      ],
      "accessed_at": "2026-10-28"
    },
    {
      "id": "S2",
      "title": "The History Manifesto, chapter 1: Going Forward by Looking Back",
      "url": "https://www.cambridge.org/core/services/aop-cambridge-core/content/view/AC1A1EC711AE91A4F9004E7582D79AFD/9781107076341AR.pdf/The_History_Manifesto.pdf?event-type=FTLA",
      "publisher": "Jo Guldi & David Armitage / Cambridge University Press",
      "source_type": "scholarly",
      "access_note": "剑桥大学出版社开放PDF已打开，读到第1章关于布罗代尔交叠时间层次的概述；这是后来的学术解释，并非布罗代尔原文。",
      "supports": [
        "将地理环境、社会/经济节律与事件叙事理解为相互交叠而非互斥尺度",
        "长时段可能过度静态化，需结合事件与人类能动性"
      ],
      "accessed_at": "2026-10-28"
    }
  ],
  "rights": {
    "summary": "本条为原创中文方法摘要；史书原文及学术文章各有其版权或公版状态，具体重用条件按来源页面为准。未复制长段原文、私人材料或题库。",
    "item_reproduction": "not-included",
    "source_ids": [
      "S1",
      "S2"
    ]
  },
  "known_gaps": [
    "阅读了1958年文章的可提取部分及剑桥出版社导读，不是完整阅读布罗代尔全部著作。",
    "长时段、周期与事件三类是便于操作的研究组织方式；不同问题需要调整窗口，不能机械套用。"
  ],
  "distillation_method": "实际打开原文或作者/机构学术材料后进行原创摘要；将作者主张、后世研究、文本局限和本条设计推演分开。",
